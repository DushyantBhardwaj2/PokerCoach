# ChromaDB configuration
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=poker_books

# Embedding settings
# Options: "local" (sentence-transformers) or "gemini"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional: Google Gemini API key (coach paragraph synthesis; falls back to a
# deterministic grounded paragraph when empty)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# Hybrid Retrieval weights (must sum to 1.0)
VECTOR_WEIGHT=0.70
BM25_WEIGHT=0.30

# PostgreSQL persistence (per-user opponent + hand data). A reachable Postgres
# server is required before starting the backend; tables are created on startup.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/poker_coach
